{
  "name": "todo-client",
  "version": "1.0.0",
  "description": "This sample implements a client for the [ToDoItem sample API](../../api). It includes an SDK generated by Kiota in the [Client](./src/Client/) folder.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "lint": "eslint src --ext ts",
    "check-format": "prettier --check ./src/*.ts",
    "format": "prettier --write ./src/*.ts",
    "build": "tsc -p ./",
    "start": "npm run build && node ./dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@microsoft/kiota-authentication-azure": "^1.0.0-preview.113",
    "@microsoft/kiota-bundle": "^1.0.0-preview.113"
  }
}
